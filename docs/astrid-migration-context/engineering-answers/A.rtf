\fs32 \
\pard\tx220\tx720\pardeftab720\li720\fi-720\partightenfactor0
\ls5\ilvl0
\f1 \cf2 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Discovery:
\f0 \'a0probe GPU/VRAM, RAM, per-volume disk free, OS/arch; select bundles from a\'a0
\f1 signed, version-pinned index
\f0 \'a0(
\f6\fs28 \cb5 models.json
\f0\fs32 \cb3 : sha256, size, license, min-VRAM, deps). No floating "latest"; index updates are reviewed repo changes, same discipline as\'a0
\f6\fs28 \cb5 ready_templates
\f0\fs32 \cb3 .\cb1 \
\ls5\ilvl0
\f1 \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Download:
\f0 \'a0HTTP range-resumable into\'a0
\f6\fs28 \cb5 <id>.part
\f0\fs32 \cb3 \'a0with sidecar progress; chunk-hash manifests enable surgical resume after corruption rather than full restart.\cb1 \
\ls5\ilvl0
\f1 \cb3 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Verify/install:
\f0 \'a0stream SHA-256 against the manifest; record license acceptance (timestamp + text hash); install via temp\uc0\u8594 rename with fsync; write an install receipt\'a0
